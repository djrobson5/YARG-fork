<?xml version="1.0" encoding="utf-8"?>
<!--
  The machine-level NuGet config on the dev box has no package sources, so this
  project pins nuget.org itself. Scoped to tools/SpPathTests so nothing about the
  Unity project's NuGetForUnity setup changes.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
